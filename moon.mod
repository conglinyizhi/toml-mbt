name = "conglinyizhi/toml"

version = "0.1.0"

import {
  "bobzhang/lexer@0.2.1",
}

readme = "README.md"

license = "Apache-2.0"

keywords = [ "toml", "parser", "config" ]

description = "Nightly-compatible TOML parser for MoonBit, maintained from moonbit-community/toml-parser"

warnings = "+a-unused_optional_argument-unused_default_value-missing_invariant-missing_reasoning"
